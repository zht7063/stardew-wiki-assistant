{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stardew-wiki-assistant",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    { "pattern": "stardewiki.tianyubai.cn", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "kv_namespaces": [
    {
      "binding": "WIKI_CACHE",
      "id": "11d435912c9b4141be03abdd278f57cc"
    }
  ],
  "d1_databases": [
    {
      "binding": "WIKI_DB",
      "database_name": "stardew-wiki",
      "database_id": "242ec9c4-3485-47a0-a56f-3de8fbe9528d"
    }
  ],
  "vectorize": [
    {
      "binding": "WIKI_VECTORS",
      "index_name": "stardew-wiki"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_STORE",
        "class_name": "ChatStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatStore"]
    }
  ]
}
