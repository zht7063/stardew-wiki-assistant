# Copy to .dev.vars. Wrangler loads this file for `wrangler dev` only.
# Never commit the real file.

# DeepSeek key. Required unless MOCK_LLM=1.
# Create one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Set to 1 to preview the app without a key. Wiki lookups stay live;
# the narrator that decides tool calls and wording is scripted.
MOCK_LLM=

# Local wrangler fetch is HTTP/1.1, which the wiki's Cloudflare check
# challenges. `npm run dev` starts scripts/wiki-proxy.mjs on this port.
# Leave unset in production: deployed Workers negotiate HTTP/2 themselves.
WIKI_PROXY=http://127.0.0.1:8791

# Optional shared passphrase. When set, the phone must unlock before
# /api/chat will spend the DeepSeek key. Leave empty for local use.
APP_PASSWORD=
